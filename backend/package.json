{
    "name": "viernulvier-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "prisma generate && tsc",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/src/server.js",
        "test": "npm run test:prepare && vitest run",
        "test:watch": "npm run test:prepare && vitest",
        "test:coverage": "npm run test:prepare && vitest run --coverage",
        "test:prepare": "npm run db:generate && npm run test:db:up && PRISMA_ENV_FILE=.env.test NODE_ENV=test prisma db push",
        "test:db:up": "node test/scripts/ensure-test-db.mjs",
        "test:db:down": "docker compose -f test/docker-compose.yml down",
        "lint": "eslint src/",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev && prisma generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "scraper": "tsx src/scraper/sync_database.ts",
        "db:import-legacy": "tsx src/import/import-legacy-csv.ts --productions ./data/productions.csv --events ./data/events.csv"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.0",
        "@fastify/cors": "^11.0.0",
        "@fastify/helmet": "^13.0.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/sensible": "^6.0.0",
        "@fastify/swagger": "^9.0.0",
        "@fastify/swagger-ui": "^5.0.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.1",
        "axios": "^1.15.0",
        "axios-retry": "^4.5.0",
        "dotenv": "^17.3.1",
        "fastify": "^5.8.5",
        "csv-parse": "^6.2.1",
        "fastify-plugin": "^5.0.0",
        "fastify-type-provider-zod": "^4.0.0",
        "pg": "^8.19.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.19.17",
        "@types/pg": "^8.18.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.7.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.0",
        "typescript": "~5.7.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.0.0"
    }
}
