{
    "name": "viernulvier-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev && prisma generate",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.0",
        "@fastify/cors": "^11.0.0",
        "@fastify/helmet": "^13.0.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/sensible": "^6.0.0",
        "@fastify/swagger": "^9.0.0",
        "@fastify/swagger-ui": "^5.0.0",
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.4.1",
        "axios": "^1.13.6",
        "axios-retry": "^4.5.0",
        "dotenv": "^17.3.1",
        "fastify": "^5.0.0",
        "fastify-plugin": "^5.0.0",
        "fastify-type-provider-zod": "^4.0.0",
        "pg": "^8.19.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.18.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.0.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.4.1",
        "tsx": "^4.19.0",
        "typescript": "~5.7.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.0.0"
    }
}
