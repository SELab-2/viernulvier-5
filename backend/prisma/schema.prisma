generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model crop {
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  id         String    @id @db.Uuid @default(uuid())
  name       String?  @db.VarChar
  url        String?  @db.VarChar
  item       item[]
}

model crosssells {
  created_at                       DateTime @default(now()) @db.Timestamp(6)
  updated_at                       DateTime @default(now()) @db.Timestamp(6)
  id                               String   @id @db.Uuid @default(uuid())
  ticket_id                        String?  @db.Uuid
  ticket_type                      String?  @db.VarChar
  booking_id                       String?  @db.VarChar
  price                            String?  @db.VarChar
  hall_section_code                String?  @db.VarChar
  order_id                         String?  @db.Uuid
  order                            order?   @relation("crosssells_order", fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket                           ticket?  @relation("crosssells_ticket", fields: [ticket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model event {
  created_at                              DateTime      @default(now()) @db.Timestamp(6)
  updated_at                              DateTime      @default(now()) @db.Timestamp(6)
  id                                      String         @id @db.Uuid @default(uuid())
  starts_at                               DateTime?     @db.Timestamp(6)
  ends_at                                 DateTime?     @db.Timestamp(6)
  intermission_at                         DateTime?     @db.Timestamp(6)
  doors_at                                DateTime?     @db.Timestamp(6)
  box_office_id                           String?       @db.VarChar
  vendor_id                               String?       @db.VarChar
  max_tickets_per_order                   Int?
  uitdatabank_id                          String?       @db.VarChar
  secure                                  Boolean?
  sms_verification                        Boolean?
  info                                    Json?
  eticket_info                            Json?
  external_order_url                      Json?
  order_url                               String?       @db.VarChar
  production_id                           String?       @db.Uuid
  status_id                               String?       @db.Uuid
  hall_id                                 String?       @db.Uuid
  hall                                    hall?         @relation("event_hall", fields: [hall_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  production                              production?   @relation("event_production", fields: [production_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status                                  status?       @relation("event_status", fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_prices                            event_price[]
  tickets                                 ticket[]      @relation("ticket_event")
}

model event_price {
  created_at                     DateTime  @default(now()) @db.Timestamp(6)
  updated_at                     DateTime  @default(now()) @db.Timestamp(6)
  id                             String     @id @db.Uuid @default(uuid())
  event_id                       String?   @db.Uuid
  available                      Int?
  amount                         String?   @db.VarChar
  box_office_id                  String?   @db.VarChar
  contigent_id                   Int?
  expires_at                     DateTime? @db.Timestamp(6)
  price_id                       String?   @db.Uuid
  rank_id                        String?   @db.Uuid
  event                          event?    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  price                          price?    @relation("event_price_price", fields: [price_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rank                           rank?     @relation("event_price_rank", fields: [rank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model gallery {
  created_at                                    DateTime       @default(now()) @db.Timestamp(6)
  updated_at                                    DateTime       @default(now()) @db.Timestamp(6)
  id                                            String          @id @db.Uuid @default(uuid())
  name                                          String?        @db.VarChar
  gallery_item                                  gallery_item[]
  items                                         item[]         @relation("item_gallery")
  media_gallery_productions                     production[]   @relation("production_media_gallery")
  poster_gallery_productions                    production[]   @relation("production_poster_gallery")
  review_gallery_productions                    production[]   @relation("production_review_gallery")
  tags                                          tag[]          @relation("tag_gallery")
}

model gallery_item {
  gallery_id String  @db.Uuid
  item_id    String  @db.Uuid
  gallery    gallery @relation(fields: [gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item       item    @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([gallery_id, item_id])
}

model genre {
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @default(now()) @db.Timestamp(6)
  id               String              @id @db.Uuid @default(uuid())
  type             String?            @db.VarChar
  use_as           String?            @db.VarChar
  vendor_id        String?            @db.VarChar
  name             Json?
  slug             Json?
  description      Json?
  genre_production genre_production[]
}

model genre_production {
  genre_id      String     @db.Uuid
  production_id String     @db.Uuid
  genre         genre      @relation(fields: [genre_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  production    production @relation(fields: [production_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([genre_id, production_id])
}

model hall {
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @db.Timestamp(6)
  id                      String    @id @db.Uuid @default(uuid())
  vendor_id               String?  @db.VarChar
  box_office_id           String?  @db.VarChar
  seat_selection          String?  @db.VarChar
  open_seating            String?  @db.VarChar
  name                    Json?
  remark                  Json?
  space_id                String?  @db.Uuid
  events                  event[]  @relation("event_hall")
  space                   space?   @relation("hall_space", fields: [space_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model item {
  created_at                    DateTime       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime       @default(now()) @db.Timestamp(6)
  id                            String          @id @db.Uuid @default(uuid())
  type                          String?        @db.VarChar
  original_filename             String?        @db.VarChar
  position                      Int?
  width                         Int?
  height                        Int?
  format                        String?        @db.VarChar
  gallery_id                    String?        @db.Uuid
  title                         Json?
  description                   Json?
  credits                       Json?
  link                          Json?
  crops                         String?        @db.Uuid
  gallery_item                  gallery_item[]
  crop                          crop?          @relation(fields: [crops], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gallery                       gallery?       @relation("item_gallery", fields: [gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model location {
  created_at                     DateTime @default(now()) @db.Timestamp(6)
  updated_at                     DateTime @default(now()) @db.Timestamp(6)
  id                             String    @id @db.Uuid @default(uuid())
  name                           Json?
  code                           String?  @db.VarChar
  street                         String?  @db.VarChar
  number                         String?  @db.VarChar
  postal_code                    String?  @db.VarChar
  city                           String?  @db.VarChar
  phone_1                        String?  @db.VarChar
  phone_2                        String?  @db.VarChar
  own_location                   String?  @db.VarChar
  country                        String?  @db.VarChar
  uitdatabank_id                 String?  @db.VarChar
  space                          space[]  @relation("space_location")
}

model mailinglist {
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  id                     String                    @id @db.Uuid @default(uuid())
  name                   String?                  @db.VarChar
  type                   String?                  @db.VarChar
  public                 String?                  @db.VarChar
  one_time               String?                  @db.VarChar
  subscriber_mailinglist subscriber_mailinglist[]
}

model optins {
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @default(now()) @db.Timestamp(6)
  id                String               @id @db.Uuid @default(uuid())
  key_name          String?             @db.VarChar
  name              String?             @db.VarChar
  title             Json?
  description       Json?
  provider          String?             @db.VarChar
  code              String?             @db.VarChar
  type              String?             @db.VarChar
  subscriber_optins subscriber_optins[]
}

model order {
  created_at                           DateTime      @default(now()) @db.Timestamp(6)
  updated_at                           DateTime      @default(now()) @db.Timestamp(6)
  id                                   String         @id @db.Uuid @default(uuid())
  ordered_at                           DateTime?     @db.Timestamp(6)
  total_amount                         String?       @db.VarChar
  box_office_id                        String?       @db.VarChar
  visitor_id                           String?       @db.Uuid
  publiq_statistical_sector_id         String?       @db.VarChar

  crosssells                           crosssells[]  @relation("crosssells_order")
  visitor                              visitor?      @relation("order_visitor", fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordertickets                         orderticket[] @relation("orderticket_order")
  tickets                              ticket[]      @relation("ticket_order")
}

model orderticket {
  created_at                        DateTime @default(now()) @db.Timestamp(6)
  updated_at                        DateTime @default(now()) @db.Timestamp(6)
  id                                String    @id @db.Uuid @default(uuid())
  ticket_type                       String?  @db.VarChar
  booking_id                        String?  @db.VarChar
  price                             String?  @db.VarChar
  hall_section_code                 String?  @db.VarChar
  order_id                          String?  @db.Uuid
  ticket_id                         String?  @db.Uuid
  order                             order?   @relation("orderticket_order", fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket                            ticket?  @relation("orderticket_ticket", fields: [ticket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model organisations {
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  id         String    @id @db.Uuid @default(uuid())
  name       String?  @db.VarChar
}

model price {
  created_at                           DateTime      @default(now()) @db.Timestamp(6)
  updated_at                           DateTime      @default(now()) @db.Timestamp(6)
  id                                   String         @id @db.Uuid @default(uuid())
  type                                 String?       @db.VarChar
  visibility                           String?       @db.VarChar
  code                                 String?       @db.VarChar
  description                          Json?
  minimum                              Int?
  maximum                              Int?
  step                                 Int?
  order                                Int?
  auto_select_combo                    Boolean?
  include_in_price_range               Boolean?
  cineville_box                        Boolean?
  membership                           String?       @db.VarChar
  event_prices                         event_price[] @relation("event_price_price")
  tickets                              ticket[]      @relation("ticket_price")
}

model production {
  created_at                                 DateTime                   @default(now()) @db.Timestamp(6)
  updated_at                                 DateTime                   @default(now()) @db.Timestamp(6)
  id                                         String                      @id @db.Uuid @default(uuid())
  vendor_id                                  String?                    @db.VarChar
  box_office_id                              Int?
  performer_field                            String?                    @db.VarChar
  performer_type                             String?                    @db.VarChar
  attendance_mode                            String?                    @db.VarChar
  super_title                                Json?
  title                                      Json?
  artist                                     Json?
  meta_title                                 Json?
  meta_description                           Json?
  tagline                                    Json?
  teaser                                     Json?
  description                                Json?
  description_extra                          Json?
  description_2                              Json?
  video_1                                    Json?
  video_2                                    Json?
  quote                                      Json?
  quote_source                               Json?
  programme                                  Json?
  info                                       Json?
  description_short                          Json?
  eticket_info                               Json?
  custom_data                                Json?
  media_gallery_id                           String?                    @db.Uuid
  review_gallery_id                          String?                    @db.Uuid
  poster_gallery_id                          String?                    @db.Uuid
  uitdatabank_theme                          String?                    @db.Uuid
  uitdatabank_type                           String?                    @db.Uuid
  events                                     event[]                    @relation("event_production")
  genre_production                           genre_production[]
  media_gallery                              gallery?                   @relation("production_media_gallery", fields: [media_gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  poster_gallery                             gallery?                   @relation("production_poster_gallery", fields: [poster_gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review_gallery                             gallery?                   @relation("production_review_gallery", fields: [review_gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uitdatabank_themes                         uitdatabank_themes?        @relation(fields: [uitdatabank_theme], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uitdatabank_types                          uitdatabank_types?         @relation(fields: [uitdatabank_type], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uit_keywords_productions                   uit_keywords_productions[]
}

model rank {
  created_at                         DateTime      @default(now()) @db.Timestamp(6)
  updated_at                         DateTime      @default(now()) @db.Timestamp(6)
  id                                 String         @id @db.Uuid @default(uuid())
  description                        Json?
  code                               String?       @db.VarChar
  position                           Int?
  sold_out_buffer                    Int?
  event_prices                       event_price[] @relation("event_price_rank")
  tickets                            ticket[]      @relation("ticket_rank")
}

model space {
  created_at                        DateTime  @default(now()) @db.Timestamp(6)
  updated_at                        DateTime  @default(now()) @db.Timestamp(6)
  id                                String     @id @db.Uuid @default(uuid())
  vendor_id                         String?   @db.VarChar
  name                              Json?
  location_id                       String?   @db.Uuid
  halls                             hall[]    @relation("hall_space")
  location                          location? @relation("space_location", fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model status {
  created_at                 DateTime @default(now()) @db.Timestamp(6)
  updated_at                 DateTime @default(now()) @db.Timestamp(6)
  id                         String    @id @db.Uuid @default(uuid())
  name                       Json?
  short_name                 String?  @db.VarChar
  fixed                      Boolean?
  visible                    Boolean?
  bookable                   Boolean?
  events                     event[]  @relation("event_status")
}

model subscriber {
  created_at                 DateTime                 @default(now()) @db.Timestamp(6)
  updated_at                 DateTime                 @default(now()) @db.Timestamp(6)
  id                         String                   @id @db.Uuid @default(uuid())
  confirmed                  Boolean?
  bounces                    Int?
  user_id                    String?                  @db.Uuid
  user                       user?                    @relation("subscriber_user", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber_mailinglist     subscriber_mailinglist[]
  subscriber_optins          subscriber_optins[]
}

model subscriber_mailinglist {
  subscriber_id  String      @db.Uuid
  mailinglist_id String      @db.Uuid
  mailinglist    mailinglist @relation(fields: [mailinglist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber     subscriber  @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([subscriber_id, mailinglist_id])
}

model subscriber_optins {
  subscriber_id String     @db.Uuid
  optins_id     String     @db.Uuid
  optins        optins     @relation(fields: [optins_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber    subscriber @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([subscriber_id, optins_id])
}

model tag {
  created_at                   DateTime       @default(now()) @db.Timestamp(6)
  updated_at                   DateTime       @default(now()) @db.Timestamp(6)
  id                           String          @id @db.Uuid @default(uuid())
  source                       String?        @db.VarChar
  sourcetype                   String?        @db.VarChar
  enable                       String?        @db.VarChar
  code                         String?        @db.VarChar
  name                         Json?
  short_description            Json?
  url                          String?        @db.VarChar
  url_title                    Json?
  expires_after                Int?
  automatically_assigned       Boolean?
  external                     Boolean?
  gallery_id                   String?        @db.Uuid
  gallery                      gallery?       @relation("tag_gallery", fields: [gallery_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitor_tags                 visitor_tags[]
}

model ticket {
  created_at                             DateTime      @default(now()) @db.Timestamp(6)
  updated_at                             DateTime      @default(now()) @db.Timestamp(6)
  id                                     String         @id @db.Uuid @default(uuid())
  available_from                         DateTime?     @db.Timestamp(6)
  seat_id                                String?       @db.VarChar
  seat_row                               String?       @db.VarChar
  seat_description                       String?       @db.VarChar
  external_data                          String?
  order_id                               String?       @db.Uuid
  event_id                               String?       @db.Uuid
  price_id                               String?       @db.Uuid
  rank_id                                String?       @db.Uuid

  crosssells                             crosssells[]  @relation("crosssells_ticket")
  ordertickets                           orderticket[] @relation("orderticket_ticket")
  event                                  event?        @relation("ticket_event", fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order                                  order?        @relation("ticket_order", fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  price                                  price?        @relation("ticket_price", fields: [price_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rank                                   rank?         @relation("ticket_rank", fields: [rank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model uit_keywords_productions {
  production_id        String               @db.Uuid
  uitkeywords_id       String               @db.Uuid
  production           production           @relation(fields: [production_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uitdatabank_keywords uitdatabank_keywords @relation(fields: [uitkeywords_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([production_id, uitkeywords_id])
}

model uitdatabank_keywords {
  created_at               DateTime                   @default(now()) @db.Timestamp(6)
  updated_at               DateTime                   @default(now()) @db.Timestamp(6)
  id                       String                      @id @db.Uuid @default(uuid())
  name                     String?                    @db.VarChar
  uit_keywords_productions uit_keywords_productions[]
}

model uitdatabank_themes {
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  id         String        @id @db.Uuid @default(uuid())
  name       String?      @db.VarChar
  cdb_cat_id String?      @db.VarChar
  production production[]
}

model uitdatabank_types {
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  id         String        @id @db.Uuid @default(uuid())
  name       String?      @db.VarChar
  cdb_cat_id String?      @db.VarChar
  production production[]
}

model user {
  created_at                       DateTime     @default(now()) @db.Timestamp(6)
  updated_at                       DateTime     @default(now()) @db.Timestamp(6)
  id                               String        @id @db.Uuid @default(uuid())
  last_active_at                   DateTime?    @db.Timestamp(6)
  gender                           String?      @db.VarChar
  initials                         String?      @db.VarChar
  postcode                         String?      @db.VarChar
  city                             String?      @db.VarChar
  country                          String?      @db.VarChar
  date_of_birth                    DateTime?    @db.Timestamp(6)
  visitor_id                       String?      @unique @db.Uuid
  subscribers                      subscriber[] @relation("subscriber_user")
  visitor                          visitor?     @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model visitor {
  created_at                                 DateTime       @default(now()) @db.Timestamp(6)
  updated_at                                 DateTime       @default(now()) @db.Timestamp(6)
  id                                         String          @id @db.Uuid @default(uuid())
  box_office_id                              String?        @db.VarChar
  optins_chosen                              Boolean?
  optins_skipped_at                          DateTime?      @db.Timestamp(6)
  orders                                     order[]        @relation("order_visitor")
  user                                       user?          
  visitor_tags                               visitor_tags[] @relation("visitor_tags_visitor")
}

model visitor_tags {
  id                                    String     @id @db.Uuid @default(uuid())
  external_data                         String?
  expires_at                            DateTime? @db.Timestamp(6)
  visitor_id                            String?   @db.Uuid
  tags                                  String?   @db.Uuid
  tag                                   tag?      @relation(fields: [tags], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitor                               visitor?  @relation("visitor_tags_visitor", fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Scaffold-specific admin model for dashboard authentication.
enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id        String    @id @default(uuid()) @db.Uuid
  username  String    @unique @db.VarChar
  passwordHash String @map("password_hash") @db.VarChar
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("users")
}
